# Contraseñas de acceso por rol (cámbialas antes de compartir la app)
MACONDO_PASSWORD=cambia-esta-clave
CLIENTE_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión (usa cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# Redis (Upstash) — crea la base desde el marketplace de Vercel ("Upstash Redis")
# y estas variables se agregan automáticamente al proyecto.
# Acepta cualquiera de los dos pares de nombres:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# o bien:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
